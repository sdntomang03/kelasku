{
  "name": "cbt",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "desktop": "npm run build:desktop && electron .",
    "dist:windows": "npm run build:desktop && electron-builder --win nsis",
    "lint": "eslint src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "jeep-sqlite": "^2.8.0",
    "katex": "^0.18.9",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.11.0",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "electron": "^39.2.7",
    "electron-builder": "^26.7.0",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.ujianpro.kelasku",
    "productName": "Kelasku",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kelasku"
    }
  }
}
